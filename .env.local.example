# Copia este archivo a .env.local (nunca subir .env.local a git)

# --- Sanity (blog + contactos) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Token con permiso SOLO de "Create" (no Admin). Crear en sanity.io/manage
SANITY_WRITE_TOKEN=

# --- Resend (correo de notificación de leads) ---
RESEND_API_KEY=

# --- Cloudflare Turnstile (anti-spam del formulario) ---
# OBLIGATORIO en producción: ambas variables deben tener valor.
# Si falta cualquiera de las dos, el formulario rechazará todos los envíos
# en producción. En desarrollo local pueden dejarse vacías para omitir la
# verificación, pero no omitirlas en Vercel → Settings → Environment Variables.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
